{
  "name": "dsh-remote-companion",
  "private": true,
  "version": "0.1.0",
  "description": "Portable desktop companion for the dsh-remote-control console",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "pnpm check && pnpm build && pnpm run test:rust:compile && pnpm run test:rust",
    "test:rust:compile": "cargo test --locked --manifest-path src-tauri/Cargo.toml --no-run",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml -- --test-threads=1",
    "test:rust:windows": "cargo test --locked --manifest-path src-tauri/Cargo.toml --target x86_64-pc-windows-msvc -- --test-threads=1",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "build:rust": "tauri build --no-bundle",
    "dist": "pnpm run build:rust && node scripts/assemble-portable.mjs",
    "test:mock": "node test/mock-remote.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@lucide/svelte": "^1.75.0",
    "@tauri-apps/api": "^2.9.3",
    "bits-ui": "^2.20.0",
    "cn": "^0.5.2",
    "shadcn-svelte": "^1.8.1",
    "tailwind-variants": "^3.3.0"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.9.6",
    "@types/node": "^26.6.6",
    "mode-watcher": "^1.1.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.3",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  }
}
